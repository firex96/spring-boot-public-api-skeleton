# 논리 키 목록 — 운영에서 환경변수로 줄 때의 이름이다 (Spring 이 DB_WRITER_PASSWORD → db-writer-password 로 대응시킨다).
# aws·azure·gcp 프로필을 쓰면 비밀 값은 비밀 저장소에 같은 논리 키 이름(kebab-case)으로 둔다. README 「설정과 비밀값」 참고.
# 이 파일을 .env 로 복사해 쓸 수 있다 (.env 는 커밋하지 않는다).

# --- 설정 (비밀 아님) ---
DB_HOST=localhost
DB_PORT=3306
# DB_READ_HOST=           # 읽기 복제본 호스트 (없으면 DB_HOST)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_SSL_ENABLED=false
# REDIS_MANAGED_CLUSTER=false   # 관리형 Redis 클러스터(단일 엔드포인트)면 true
CORE_API_URL=http://localhost:9999
OIDC_ISSUER=http://localhost:8080          # 이 서비스의 외부 주소 (id_token iss)
OAUTH2_REDIRECT_BASE_URL=http://localhost:8080
# SPRING_FLYWAY_ENABLED=true   # skeleton_auth 마이그레이션 (local 프로필은 켜져 있다)

# --- 비밀 ---
DB_READER_USERNAME=skeleton_reader
DB_READER_PASSWORD=
DB_WRITER_USERNAME=skeleton_writer
DB_WRITER_PASSWORD=
DB_ADMIN_USERNAME=skeleton_admin   # Flyway 전용 (skeleton_auth DDL)
DB_ADMIN_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=                        # 32자 이상
# OIDC_RSA_PRIVATE_KEY=            # RS256 을 켤 때 (application.yml 의 oidc 주석 참고)
# OIDC_RSA_PUBLIC_KEY=
# NAVER_CLIENT_ID=                 # 소셜 로그인을 켤 때 (application.yml 의 oauth2 주석 참고)
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- 비밀값 출처 프로필 (SPRING_PROFILES_ACTIVE=aws|azure|gcp, 필요하면 ,loki) ---
# AWS_SECRET_ID=public-api-skeleton/prod
# AZURE_KEYVAULT_ENDPOINT=https://<vault-name>.vault.azure.net/
# AZURE_KEYVAULT_CHALLENGE_RESOURCE_VERIFICATION_ENABLED=true   # 에뮬레이터·사설 엔드포인트에서만 false
# GCP_PROJECT_ID=<project-id>
# LOKI_URL=http://loki:3100/loki/api/v1/push
